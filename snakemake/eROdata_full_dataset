from config import *
sys.path.insert(1, eROdata_path)
from eROdata import *

#calculate quantities

downsample_exp=int(exp_bin/evt_bin)
downsample_psf=int(psf_bin/evt_bin)

width=float(source_reg[source_reg.rfind(",")+1:source_reg.rfind(")")].strip())*2
pix=int(width*3600/evt_bin)
x_list=list(range(0,pix,downsample_exp))
x_min=min(x_list)
x_max=max(x_list)+downsample_exp
y=x_list


#function definitions

def get_final_dataset_list():
    l=[]
    if output_stacked:
        l.append(out_path+"dataset_stacked.fits.gz")
    if output_tms:
        l.extend([out_path+"dataset_TM"+str(i)+".fits.gz" for i in tms])
    if not on_off:
        l.extend([out_path+"background_TM"+str(i)+".fits.gz" for i in tms])
    return l

def get_output_list():
    l=[expand("{out_path}evt_TM{tm}_conv.fits",out_path=out_path,tm=tms),\
        expand("{out_path}expmap_TM{tm}.fits",out_path=out_path,tm=tms),\
        expand("{out_path}quantized_arf_exp_b{downsample}_{tm}.fits.gz",out_path=out_path,downsample=downsample_exp,tm=tms),\
        ]
    if not pointed:
        l.append(expand("{out_path}psfmap_{tm}.fits.gz",out_path=out_path,tm=tms))
    return l


#rule definitions

rule all:
    input:
        get_final_dataset_list()
    
rule make_datasets:
    input:
        get_output_list()
        #evtfile_conv=expand("{out_path}evt_TM{tm}_conv.fits",out_path=out_path,tm=tms),
        #exp_t_map=expand("{out_path}expmap_TM{tm}.fits",out_path=out_path,tm=tms),
        #expmap=expand("{out_path}quantized_arf_exp_b{downsample}_{tm}.fits.gz",out_path=out_path,downsample=downsample_exp,tm=tms),
        #psf_map=expand("{out_path}psfmap_{tm}.fits",out_path=out_path,tm=tms)
    output:
        get_final_dataset_list()
    conda:'gammapy.yaml'
    resources:
        runtime=runtime_make_datasets,
        mem_mb=mem_mb_make_datasets
    run:
        width_fg=Regions.parse(fg_reg, format="ds9")[0].radius.to(u.deg).value*2
        width_bg=Regions.parse(bg_reg, format="ds9")[0].radius.to(u.deg).value*2

        for i,val in enumerate(tms):
            data_src=eROdata(evtfile_list,\
                 fg_reg,\
                 out_path,tms=[val], pointed=pointed, catalog_path=catalog_path)
            data_src.find_data_products()
            data_src.load_data(wid=width_fg,binsize=evt_bin,binsize_irf=binsize_irf, srctool_like=srctool_like)

            data_bkg=eROdata(evtfile_list,\
                 bg_reg,\
                 out_path,tms=[val],pointed=pointed, catalog_path=catalog_path)
            data_bkg.find_data_products()
            data_bkg.load_data(wid=width_bg,binsize=evt_bin*4,binsize_irf=600, srctool_like=srctool_like)
               
            data_src.background_spectrum(data_src, data_src.region,ext_mask=bkg_ext_mask,to_mask_out=bkg_exclude_reg,on_off=on_off,exp=bkg_weighting_exp)
            #data_src.datasets[0] = data_src.datasets[0].cutout(data_src.region.center,width_fg*u.deg)

            if output_stacked:
                if i==0:
                    stacked=data_src.datasets[0].copy()
                    backgr_spec = data_src.backgr_spectra[0].copy()
                if i >0:
                    stacked.stack(data_src.datasets[0])
                    backgr_spec.stack(data_src.backgr_spectra[0])
                
            if wstat_rebin_n:
                data_src.datasets[0] = wstat_rebin(data_src.datasets[0],wstat_rebin_n)
            data_src.datasets[0] = rebin_energy_bounds(data_src.datasets[0])
            
            if output_tms:
                data_src.write_to_files(tms=[val],stacked=False)
        if output_stacked:
            data_src.stacked=stacked
            data_src.backgr_stacked=backgr_spec
            data_src.stacked = wstat_rebin(data_src.stacked,wstat_rebin_n)
            data_src.stacked = rebin_energy_bounds(data_src.stacked)
            data_src.write_to_files(tms=None,stacked=True)


