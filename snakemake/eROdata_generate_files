from config import *
sys.path.insert(1, eROdata_path)
from eROdata import *

#calculate quantities

downsample_exp=int(exp_bin/4)
downsample_psf=int(psf_bin/4)

width=float(source_reg[source_reg.rfind(",")+1:source_reg.rfind(")")].strip())*2
pix=int(width*3600/4)
x_list=list(range(0,pix,downsample_exp))
x_min=min(x_list)
x_max=max(x_list)+downsample_exp
y=x_list

#generate list of output files
def get_output_list():
    l=[expand("{out_path}evt_TM{tm}_conv.fits",out_path=out_path,tm=tms),\
        expand("{out_path}expmap_TM{tm}.fits",out_path=out_path,tm=tms),\
        expand("{out_path}quantized_arf_exp_b{downsample}_{tm}.fits.gz",out_path=out_path,downsample=downsample_exp,tm=tms),\
        ]
    if not pointed:
        l.append(expand("{out_path}psfmap_{tm}.fits.gz",out_path=out_path,tm=tms))
    return l


#rule definitions

rule all:
    input:
        get_output_list()
