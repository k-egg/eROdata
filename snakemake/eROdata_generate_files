rule make_evtfiles_exp_t_maps:
    output:
        evtfile=expand("{out_path}evt_TM{tm}.fits",out_path=out_path,tm=tms),
        evtfile_conv=expand("{out_path}evt_TM{tm}_conv.fits",out_path=out_path,tm=tms),
        exp_t_map=expand("{out_path}expmap_TM{tm}.fits",out_path=out_path,tm=tms)
    container:'docker://erosita/esass:latest'
    conda:'gammapy.yaml'
    resources:
        runtime=20,
        mem_mb=5000
    run:
        data_src=eROdata(evtfile_list,\
                 source_reg,\
                 out_path,tms=tms,pointed=pointed, catalog_path=catalog_path)
        data_src.eSASS_data_products()

rule make_arfs:
    input:
            expand("{out_path}evt_TM{{tm}}.fits",out_path=out_path)
    output:
        expand("{out_path}scratch/{{tm}}20_ARF_00001_{x}_{{y}}_{{tm}}.fits",out_path=out_path, x=x_list)
    
    wildcard_constraints:
        tm=tms
    container: 'docker://erosita/esass:latest'
    conda: 'gammapy.yaml'
    resources:
        runtime=120,
        mem_mb=5000
    shell:
        '''
        python3 {eROdata_path}make_exposure_1.py \
        --input_evtfile={out_path}evt_TM{wildcards.tm}.fits \
        --output_path={out_path}scratch/ \
        --downsample={downsample_exp} \
        --tm={wildcards.tm} \
        --x_lo={x_min}\
        --x_hi={x_max}\
        --y={wildcards.y}
        '''

rule make_arf_map:
    input:
        expand("{out_path}scratch/{{tm}}20_ARF_00001_{x}_{y}_{{tm}}.fits",out_path=out_path, x=x_list,y=x_list)
    output:
        expand("{out_path}quantized_arf_exp_b{downsample}_{{tm}}.fits.gz", out_path=out_path, downsample=downsample_exp)
    wildcard_constraints:
        tm=tms
    container: 'docker://erosita/esass:latest'
    conda: 'gammapy.yaml'
